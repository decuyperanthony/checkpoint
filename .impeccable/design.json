  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The one action colour, Line 12 Green.",
      "html": "<button class=\"ds-btn-primary\">Déverrouiller</button>",
      "css": ".ds-btn-primary{display:inline-flex;align-items:center;justify-content:center;height:32px;padding:0 10px;border:1px solid transparent;border-radius:10px;background:var(--primary,oklch(0.5 0.11 162));color:var(--primary-foreground,oklch(0.99 0.01 162));font:500 0.875rem/1.43 \"Atkinson Hyperlegible Next\",sans-serif;cursor:pointer;transition:all .15s;outline:none}.ds-btn-primary:hover{background:color-mix(in oklch,var(--primary,oklch(0.5 0.11 162)) 80%,transparent)}.ds-btn-primary:focus-visible{border-color:var(--ring,oklch(0.5 0.11 162));box-shadow:0 0 0 3px color-mix(in oklch,var(--ring,oklch(0.5 0.11 162)) 50%,transparent)}.ds-btn-primary:active{transform:translateY(1px)}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Neutral action, e.g. retry after a failed load.",
      "html": "<button class=\"ds-btn-secondary\">Réessayer</button>",
      "css": ".ds-btn-secondary{display:inline-flex;align-items:center;height:32px;padding:0 10px;border:1px solid transparent;border-radius:10px;background:var(--secondary,oklch(0.96 0.004 250));color:var(--secondary-foreground,oklch(0.25 0.012 255));font:500 0.875rem/1.43 \"Atkinson Hyperlegible Next\",sans-serif;cursor:pointer;outline:none}.ds-btn-secondary:hover{background:color-mix(in oklch,var(--secondary,oklch(0.96 0.004 250)),var(--foreground,oklch(0.22 0.012 255)) 5%)}.ds-btn-secondary:focus-visible{border-color:var(--ring,oklch(0.5 0.11 162));box-shadow:0 0 0 3px color-mix(in oklch,var(--ring,oklch(0.5 0.11 162)) 50%,transparent)}"
    },
    {
      "name": "Ghost Icon Button",
      "kind": "button",
      "refersTo": "button-ghost-hover",
      "description": "Every icon-only control: logout, theme, the actions menu trigger.",
      "html": "<button class=\"ds-icon-btn\" aria-label=\"Actions\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"1\"/><circle cx=\"19\" cy=\"12\" r=\"1\"/><circle cx=\"5\" cy=\"12\" r=\"1\"/></svg></button>",
      "css": ".ds-icon-btn{display:inline-grid;place-items:center;width:32px;height:32px;border:1px solid transparent;border-radius:10px;background:transparent;color:var(--foreground,oklch(0.22 0.012 255));cursor:pointer;outline:none}.ds-icon-btn:hover{background:var(--muted,oklch(0.96 0.004 250))}.ds-icon-btn:focus-visible{border-color:var(--ring,oklch(0.5 0.11 162));box-shadow:0 0 0 3px color-mix(in oklch,var(--ring,oklch(0.5 0.11 162)) 50%,transparent)}"
    },
    {
      "name": "PIN Field",
      "kind": "input",
      "refersTo": "input-pin",
      "description": "Outline field, 48px, centred with the widest tracking.",
      "html": "<input class=\"ds-input-pin\" inputmode=\"numeric\" aria-label=\"Code PIN\" value=\"1234\">",
      "css": ".ds-input-pin{width:100%;max-width:24rem;height:48px;padding:4px 10px;border:1px solid var(--input,oklch(0.86 0.008 255));border-radius:10px;background:var(--card,oklch(1 0 0));color:var(--foreground,oklch(0.22 0.012 255));font:400 1.125rem \"Atkinson Hyperlegible Next\",sans-serif;text-align:center;letter-spacing:.1em;outline:none;transition:border-color .15s,box-shadow .15s}.ds-input-pin:focus-visible{border-color:var(--ring,oklch(0.5 0.11 162));box-shadow:0 0 0 3px color-mix(in oklch,var(--ring,oklch(0.5 0.11 162)) 50%,transparent)}.ds-input-pin[aria-invalid=true]{border-color:var(--destructive,oklch(0.55 0.2 27));box-shadow:0 0 0 3px color-mix(in oklch,var(--destructive,oklch(0.55 0.2 27)) 20%,transparent)}"
    },
    {
      "name": "Ghost Field",
      "kind": "input",
      "refersTo": "input-outline",
      "description": "Inline add field that sits in the track until hovered or focused.",
      "html": "<input class=\"ds-input-ghost\" placeholder=\"Ajouter un élément\">",
      "css": ".ds-input-ghost{height:36px;padding:4px 10px;border:1px solid transparent;border-radius:10px;background:transparent;color:var(--foreground,oklch(0.22 0.012 255));font:400 0.875rem \"Atkinson Hyperlegible Next\",sans-serif;outline:none}.ds-input-ghost::placeholder{color:var(--muted-foreground,oklch(0.5 0.012 255))}.ds-input-ghost:hover{background:color-mix(in oklch,var(--muted,oklch(0.96 0.004 250)) 60%,transparent)}.ds-input-ghost:focus-visible{background:var(--card,oklch(1 0 0));border-color:var(--ring,oklch(0.5 0.11 162));box-shadow:0 0 0 3px color-mix(in oklch,var(--ring,oklch(0.5 0.11 162)) 50%,transparent)}"
    },
    {
      "name": "Line with stations",
      "kind": "custom",
      "refersTo": "line-badge",
      "description": "Signature: badge, name and count, then stations on a 4px track; the travelled leg is full colour, the track ahead 25%.",
      "html": "<section class=\"ds-line\"><div class=\"ds-line-head\"><span class=\"ds-badge\">1</span><strong class=\"ds-line-name\">Tickets en cours</strong><span class=\"ds-count\">1/3</span></div><label class=\"ds-row\"><span class=\"ds-track ds-in\"></span><span class=\"ds-track ds-out ds-done\"></span><input type=\"checkbox\" class=\"ds-station\" checked><span class=\"ds-label\">Gestion des forms</span></label><label class=\"ds-row\"><span class=\"ds-track ds-in ds-done\"></span><span class=\"ds-track ds-out\"></span><input type=\"checkbox\" class=\"ds-station\"><span class=\"ds-label\">Menus d'actions</span></label><div class=\"ds-row\"><span class=\"ds-track ds-in\"></span><span class=\"ds-next\"><svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"><path d=\"M5 12h14M12 5v14\"/></svg></span><span class=\"ds-add\">Ajouter un élément</span></div></section>",
      "css": ".ds-line{--lc:var(--line-green,oklch(0.5 0.11 162));--lci:var(--line-green-foreground,oklch(0.99 0.01 162));font-family:\"Atkinson Hyperlegible Next\",sans-serif;color:var(--foreground,oklch(0.22 0.012 255));max-width:28rem}.ds-line-head{display:flex;align-items:center;gap:12px;min-height:44px}.ds-badge{display:grid;place-items:center;width:28px;height:28px;margin-left:-4px;border-radius:9999px;background:var(--lc);color:var(--lci);font-size:.875rem;font-weight:700;font-variant-numeric:tabular-nums}.ds-line-name{flex:1;font-size:1.125rem;font-weight:700;letter-spacing:-.025em}.ds-count{font-size:.875rem;color:var(--muted-foreground,oklch(0.5 0.012 255));font-variant-numeric:tabular-nums}.ds-row{position:relative;display:flex;align-items:center;gap:12px;min-height:44px;margin:0 -8px;padding:0 8px;border-radius:10px;cursor:pointer;transition:background .15s}.ds-row:hover{background:color-mix(in oklch,var(--muted,oklch(0.96 0.004 250)) 60%,transparent)}.ds-track{position:absolute;left:16px;width:4px;height:50%;background:color-mix(in oklch,var(--lc) 25%,transparent)}.ds-in{top:0}.ds-out{top:50%}.ds-track.ds-done{background:var(--lc)}.ds-station{position:relative;appearance:none;width:20px;height:20px;margin:0;border:4px solid var(--lc);border-radius:9999px;background:var(--background,oklch(0.99 0.002 250));cursor:pointer;outline:none}.ds-station:checked{background:var(--lc)}.ds-station:focus-visible{box-shadow:0 0 0 3px color-mix(in oklch,var(--ring,oklch(0.5 0.11 162)) 50%,transparent)}.ds-label{line-height:1.375;padding:8px 0}.ds-station:checked+.ds-label{color:var(--muted-foreground,oklch(0.5 0.012 255));text-decoration:line-through;text-decoration-color:color-mix(in oklch,var(--muted-foreground,oklch(0.5 0.012 255)) 60%,transparent)}.ds-next{position:relative;display:grid;place-items:center;width:20px;height:20px;box-sizing:border-box;border:2px dashed var(--input,oklch(0.86 0.008 255));border-radius:9999px;background:var(--background,oklch(0.99 0.002 250));color:var(--muted-foreground,oklch(0.5 0.012 255))}.ds-add{font-size:.875rem;color:var(--muted-foreground,oklch(0.5 0.012 255))}"
    },
    {
      "name": "Roundel Mark",
      "kind": "custom",
      "refersTo": "roundel-mark",
      "description": "The brand mark: a Line 12 Green roundel holding a check.",
      "html": "<span class=\"ds-roundel\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M20 6 9 17l-5-5\"/></svg></span>",
      "css": ".ds-roundel{display:inline-grid;place-items:center;width:36px;height:36px;border-radius:9999px;background:var(--primary,oklch(0.5 0.11 162));color:var(--primary-foreground,oklch(0.99 0.01 162))}"
    },
    {
      "name": "Actions Menu",
