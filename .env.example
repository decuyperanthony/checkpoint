# Neon Postgres connection string. Use the pooled one (host contains "-pooler").
DATABASE_URL=postgresql://user:password@ep-example-pooler.eu-central-1.aws.neon.tech/checkpoint?sslmode=require

# Optional. SHA-256 digest of the bearer token of an API client (a script, an agent), from
# `pnpm hash-api-token`. Without it the API takes no token.
API_TOKEN_HASH=
